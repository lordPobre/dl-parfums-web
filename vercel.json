{
  "version": 2,
  "regions": [
    "gru1"
  ],
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "builds": [
    {
      "src": "core/wsgi.py",
      "use": "@vercel/python"
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/css/(.*)",
      "dest": "/static/css/$1",
      "headers": { "Cache-Control": "public, max-age=3600, stale-while-revalidate=86400" }
    },
    {
      "src": "/static/img/(.*)",
      "dest": "/static/img/$1",
      "headers": { "Cache-Control": "public, max-age=604800, stale-while-revalidate=2592000" }
    },
    {
      "src": "/static/(.*)",
      "dest": "core/wsgi.py",
      "headers": { "Cache-Control": "public, max-age=86400, s-maxage=86400" }
    },
    {
      "src": "/(.*)",
      "dest": "core/wsgi.py"
    }
  ]
}